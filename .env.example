# Database
DATABASE_URL=postgresql://user:password@localhost:5432/thapar_watch

# Admin Account (Change these before deployment)
ADMIN_USER_ID=Thapar_chronicles_28
ADMIN_PASSWORD_HASH=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=7d

# File Upload
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

# Server
PORT=3001
NODE_ENV=production

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Chat Settings
CHAT_OPEN_TIME=22:00
CHAT_CLOSE_TIME=04:00
CHAT_TIMEZONE=Asia/Kolkata
