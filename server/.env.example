# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/thapar_watch

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Configuration
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,video/mp4,video/quicktime,video/webm

# Chat Configuration
CHAT_OPEN_TIME=22:00
CHAT_CLOSE_TIME=04:00
CHAT_TIMEZONE=Asia/Kolkata

# AWS S3 Configuration (Optional)
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key